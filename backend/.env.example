# Copiar a .env solo en un entorno local controlado; .env está ignorado por Git.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://<fittrack_dev_user>:<local_secret>@127.0.0.1:5432/fittrack_dev
TEST_DATABASE_URL=postgresql+psycopg://<fittrack_test_user>:<local_secret>@127.0.0.1:5432/fittrack_test
JWT_SECRET_KEY=<generate_a_random_secret_of_at_least_32_bytes>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
